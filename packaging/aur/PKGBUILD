# This file is rendered and published to the AUR (orion-bin) by the release
# workflow (.github/workflows/release.yml). Do not bump pkgver/sha256sums by
# hand; edit the template and let CI publish.
pkgname=orion-bin
_pkgname=orion
pkgver=0.1.0
pkgrel=1
pkgdesc="Free software audio mixer and routing workspace for Linux"
arch=('x86_64')
url="https://github.com/gardun0/orion"
license=('GPL-3.0-only')
depends=('glibc' 'gcc-libs' 'pipewire' 'libxcb' 'libx11' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'alsa-lib' 'fontconfig')
provides=('orion')
conflicts=('orion')
source=("${_pkgname}-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz::${url}/releases/download/v${pkgver}/${_pkgname}-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 "orion" "${pkgdir}/usr/bin/orion"
  install -Dm644 "io.github.gardun0.orion.desktop" \
    "${pkgdir}/usr/share/applications/io.github.gardun0.orion.desktop"
  install -Dm644 "io.github.gardun0.orion.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/io.github.gardun0.orion.metainfo.xml"
  install -Dm644 "io.github.gardun0.orion.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/io.github.gardun0.orion.svg"
  for size in 32 48 64 128 256 512; do
    install -Dm644 "io.github.gardun0.orion-${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/io.github.gardun0.orion.png"
  done
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
